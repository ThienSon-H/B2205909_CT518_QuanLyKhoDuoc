/* ============================================================
   AUTH PAGES – Login/Register
   ============================================================ */
.auth-container {
  display: flex;
  min-height: 100vh;
  align-items: center;
  justify-content: center;
  padding: 2rem;
  background: radial-gradient(ellipse at 50% 0%, var(--md-primary-container) 0%, var(--md-background) 70%);
}
.auth-card {
  background: var(--md-surface);
  border-radius: var(--md-radius-xl);
  box-shadow: var(--md-elevation-5);
  overflow: hidden;
  max-width: 460px;
  width: 100%;
  transition: box-shadow var(--md-duration-medium) var(--md-easing-standard);
}
.auth-card .card-header {
  background: linear-gradient(135deg, var(--md-primary) 0%, var(--md-secondary) 100%);
  color: #ffffff;
  padding: 2rem;
  text-align: center;
