  border-width: 0.2em;
}
@keyframes fadeSlideIn {
  from {
    opacity: 0;
    transform: translateY(16px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.fade-in {
  animation: fadeSlideIn var(--md-duration-long) var(--md-easing-decelerate);
}
