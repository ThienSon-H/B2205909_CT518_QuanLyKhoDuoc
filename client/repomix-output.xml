/* ============================================================
   TABLES – Material Data Table
   ============================================================ */
.table-custom {
  border-collapse: separate;
  border-spacing: 0;
  width: 100%;
  background: var(--md-surface);
  border-radius: 0 0 var(--md-radius-lg) var(--md-radius-lg);
