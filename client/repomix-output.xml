/* ============================================================
   ALERTS – Material Snackbar style
   ============================================================ */
.alert-custom {
  border-radius: var(--md-radius-md);
  font-weight: 500;
  font-size: var(--md-typescale-label);
  padding: 1rem 1.25rem;
  border: none;
  box-shadow: var(--md-elevation-2);
  display: flex;
  align-items: center;
  gap: 0.75rem;
}
.alert-danger {
  background-color: var(--md-error-container);
  color: var(--md-error);
  border-left: 4px solid var(--md-error);
}
.alert-success {
  background-color: var(--md-primary-container);
  color: var(--md-primary-hover);
  border-left: 4px solid var(--md-primary);
}
/* ============================================================
   PAGE WRAPPER
   ============================================================ */
.page-wrapper {
  max-width: 1400px;
  margin: 0 auto;
  padding: 2rem 1.5rem;
  animation: fadeSlideIn var(--md-duration-long) var(--md-easing-decelerate);
}
/* ============================================================
   NAV TABS – Material Secondary Tabs
   ============================================================ */
.nav-tabs {
  border-bottom: 2px solid var(--md-outline);
  gap: 0.5rem;
  display: flex;
}
.nav-tabs .nav-item .nav-link {
  border: none;
  background: transparent;
  padding: 0.75rem 1.5rem;
  font-weight: 500;
  font-size: var(--md-typescale-label);
  color: var(--md-on-surface-variant);
  border-radius: var(--md-radius-md) var(--md-radius-md) 0 0;
  transition: all var(--md-duration-short) var(--md-easing-standard);
  cursor: pointer;
  position: relative;
}
.nav-tabs .nav-item .nav-link::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--md-secondary);
  border-radius: 3px 3px 0 0;
  transform: scaleX(0);
  transition: transform var(--md-duration-medium) var(--md-easing-emphasized);
}
.nav-tabs .nav-item .nav-link.active {
  color: var(--md-secondary);
  font-weight: 600;
}
.nav-tabs .nav-item .nav-link.active::after {
  transform: scaleX(1);
}
.nav-tabs .nav-item .nav-link:hover {
  color: var(--md-secondary);
  background: var(--md-secondary-container);
}
