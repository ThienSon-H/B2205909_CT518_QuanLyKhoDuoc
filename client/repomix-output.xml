/* ============================================================
   DASHBOARD HEADER
   ============================================================ */
.dashboard-header {
  background: var(--md-surface);
  border-radius: var(--md-radius-lg);
  padding: 1.25rem 2rem;
  margin-bottom: 1.5rem;
